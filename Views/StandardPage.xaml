<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalculatorApp.Views.StandardPage"
             Title="Standart">

    <!-- Sayfa Ana Düzeni -->
    <Grid Margin="{StaticResource PageMargin}"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          ColumnDefinitions="*">

        <!-- 1. ÜST BAŞLIK ALANI -->
        <Grid Grid.Row="0" Margin="4,0,4,8" ColumnDefinitions="Auto,*">
            <Label Grid.Column="0" 
                   Text="Standart" 
                   Style="{StaticResource HeaderTitleStyle}" />
        </Grid>

        <!-- 2. HESAPLAMA GEÇMİŞİ / İFADE GÖSTERGESİ (Örn: 5 + 3 =) -->
        <Label Grid.Row="1" 
               x:Name="ExpressionLabel"
               Text="" 
               Style="{StaticResource DisplayExpressionStyle}" 
               HeightRequest="24"
               Margin="0,0,8,0" />

        <!-- 3. ANA SAYI / SONUÇ GÖSTERGESİ (Örn: 8) -->
        <Label Grid.Row="2" 
               x:Name="ResultLabel"
               Text="0" 
               Style="{StaticResource DisplayResultStyle}" 
               Margin="0,0,8,12" />

        <!-- 4. HAFIZA (MEMORY) ÇUBUĞU (MC, MR, M+, M-, MS) -->
        <Grid Grid.Row="3" 
              Margin="0,0,0,8"
              ColumnDefinitions="*,*,*,*,*">
            <Button Grid.Column="0" Text="MC" Style="{StaticResource MemoryButtonStyle}" Clicked="OnMemoryClearClicked" />
            <Button Grid.Column="1" Text="MR" Style="{StaticResource MemoryButtonStyle}" Clicked="OnMemoryRecallClicked" />
            <Button Grid.Column="2" Text="M+" Style="{StaticResource MemoryButtonStyle}" Clicked="OnMemoryAddClicked" />
            <Button Grid.Column="3" Text="M-" Style="{StaticResource MemoryButtonStyle}" Clicked="OnMemorySubtractClicked" />
            <Button Grid.Column="4" Text="MS" Style="{StaticResource MemoryButtonStyle}" Clicked="OnMemoryStoreClicked" />
        </Grid>

        <!-- 5. HESAP MAKİNESİ TUŞ TAKIMI (GRID 6 Satır x 4 Sütun) -->
        <Grid Grid.Row="4" 
              RowDefinitions="*,*,*,*,*,*" 
              ColumnDefinitions="*,*,*,*">

            <!-- SATIR 0: %, CE, C, ⌫ -->
            <Button Grid.Row="0" Grid.Column="0" Text="%" Style="{StaticResource OperatorButtonStyle}" Clicked="OnUnaryOperatorClicked" CommandParameter="percent" />
            <Button Grid.Row="0" Grid.Column="1" Text="CE" Style="{StaticResource ClearButtonStyle}" Clicked="OnClearEntryClicked" />
            <Button Grid.Row="0" Grid.Column="2" Text="C" Style="{StaticResource ClearButtonStyle}" Clicked="OnClearAllClicked" />
            <Button Grid.Row="0" Grid.Column="3" Text="⌫" Style="{StaticResource ClearButtonStyle}" Clicked="OnBackspaceClicked" />

            <!-- SATIR 1: 1/x, x², 2√x, ÷ -->
            <Button Grid.Row="1" Grid.Column="0" Text="1/x" Style="{StaticResource OperatorButtonStyle}" Clicked="OnUnaryOperatorClicked" CommandParameter="recip" />
            <Button Grid.Row="1" Grid.Column="1" Text="x²" Style="{StaticResource OperatorButtonStyle}" Clicked="OnUnaryOperatorClicked" CommandParameter="sqr" />
            <Button Grid.Row="1" Grid.Column="2" Text="²√x" Style="{StaticResource OperatorButtonStyle}" Clicked="OnUnaryOperatorClicked" CommandParameter="sqrt" />
            <Button Grid.Row="1" Grid.Column="3" Text="÷" Style="{StaticResource OperatorButtonStyle}" Clicked="OnOperatorClicked" CommandParameter="/" />

            <!-- SATIR 2: 7, 8, 9, × -->
            <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="3" Text="×" Style="{StaticResource OperatorButtonStyle}" Clicked="OnOperatorClicked" CommandParameter="*" />

            <!-- SATIR 3: 4, 5, 6, - -->
            <Button Grid.Row="3" Grid.Column="0" Text="4" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="1" Text="5" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="2" Text="6" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="3" Text="-" Style="{StaticResource OperatorButtonStyle}" Clicked="OnOperatorClicked" CommandParameter="-" />

            <!-- SATIR 4: 1, 2, 3, + -->
            <Button Grid.Row="4" Grid.Column="0" Text="1" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="4" Grid.Column="1" Text="2" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="4" Grid.Column="2" Text="3" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="4" Grid.Column="3" Text="+" Style="{StaticResource OperatorButtonStyle}" Clicked="OnOperatorClicked" CommandParameter="+" />

            <!-- SATIR 5: +/-, 0, ,, = -->
            <Button Grid.Row="5" Grid.Column="0" Text="+/-" Style="{StaticResource NumberButtonStyle}" Clicked="OnToggleSignClicked" />
            <Button Grid.Row="5" Grid.Column="1" Text="0" Style="{StaticResource NumberButtonStyle}" Clicked="OnDigitClicked" />
            <Button Grid.Row="5" Grid.Column="2" Text="," Style="{StaticResource NumberButtonStyle}" Clicked="OnDecimalClicked" />
            <Button Grid.Row="5" Grid.Column="3" Text="=" Style="{StaticResource EqualButtonStyle}" Clicked="OnEqualsClicked" />

        </Grid>
    </Grid>

</ContentPage>
